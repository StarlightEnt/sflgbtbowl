<style>
  :root {
    --bg: #0b0a14; --bg-mid: #171129; --bg-deep2: #241a3d;
    --ink: #f4f1fb; --ink-dim: #a89fc9;
    --red: #ff4d5e; --orange: #ff9838; --yellow: #ffd54a;
    --green: #35d68f; --blue: #3fa8ff; --purple: #b874ff;
  }
  * { box-sizing: border-box; margin: 0; padding: 0; }
  body { font-family: 'Inter', sans-serif; background: var(--bg); color: var(--ink); line-height: 1.6; }
  .display { font-family: 'Bungee', cursive; letter-spacing: 0.01em; }

  .stripe-bar { height: 5px; display: flex; }
  .stripe-bar span { flex: 1; }
  .stripe-bar .s1 { background: var(--red); } .stripe-bar .s2 { background: var(--orange); }
  .stripe-bar .s3 { background: var(--yellow); } .stripe-bar .s4 { background: var(--green); }
  .stripe-bar .s5 { background: var(--blue); } .stripe-bar .s6 { background: var(--purple); }

  nav { background: var(--bg); border-bottom: 1px solid rgba(244,241,251,0.12); }
  .nav-inner { max-width: 1180px; margin: 0 auto; padding: 18px 24px; display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 12px; }
  .wordmark { font-size: 1.15rem; color: var(--ink); text-decoration: none; line-height: 1.2; }
  .wordmark small { display: block; font-family: 'Inter', sans-serif; font-size: 0.65rem; color: var(--ink-dim); font-weight: 600; letter-spacing: 0.06em; margin-top: 3px; }
  .admin-pill { font-family: 'Bungee', cursive; font-size: 0.65rem; color: var(--bg); background: var(--purple); padding: 4px 10px; border-radius: 999px; }

  .shell { max-width: 1180px; margin: 0 auto; padding: 32px 24px 80px; display: grid; grid-template-columns: 220px 1fr; gap: 32px; align-items: start; }

  .sidebar { background: var(--bg-mid); border: 1px solid rgba(244,241,251,0.08); border-radius: 10px; padding: 18px; position: sticky; top: 24px; }
  .sidebar .label { font-size: 0.68rem; text-transform: uppercase; letter-spacing: 0.06em; color: var(--ink-dim); margin-bottom: 10px; }
  .sidebar a { display: block; padding: 10px 12px; border-radius: 6px; color: var(--ink-dim); text-decoration: none; font-size: 0.9rem; margin-bottom: 4px; }
  .sidebar a.active { background: rgba(184,116,255,0.14); color: var(--purple); font-weight: 600; }
  .sidebar .divider-line { height: 1px; background: rgba(244,241,251,0.1); margin: 12px 0; }

  .main h1 { font-size: 1.6rem; margin-bottom: 6px; }
  .main > p.sub { color: var(--ink-dim); font-size: 0.92rem; margin-bottom: 22px; }

  .legend { display: flex; gap: 18px; flex-wrap: wrap; margin-bottom: 20px; font-size: 0.8rem; color: var(--ink-dim); }
  .legend span.dot { display: inline-block; width: 8px; height: 8px; border-radius: 50%; margin-right: 6px; vertical-align: middle; }
  .dot.needs { background: var(--yellow); }
  .dot.set { background: var(--green); }
  .team-key { font-size: 0.76rem; color: var(--ink-dim); margin-bottom: 16px; line-height: 1.8; }
  .team-key strong { color: var(--ink); font-weight: 600; }

  .card { background: var(--bg-mid); border: 1px solid rgba(244,241,251,0.08); border-radius: 10px; padding: 20px; margin-bottom: 20px; }

  table.sched { width: 100%; border-collapse: collapse; font-size: 0.85rem; }
  table.sched th { text-align: left; color: var(--ink-dim); font-weight: 600; font-size: 0.7rem; text-transform: uppercase; letter-spacing: 0.04em; padding: 7px 8px; border-bottom: 1px solid rgba(244,241,251,0.14); }
  table.sched td { padding: 7px 8px; border-bottom: 1px solid rgba(244,241,251,0.06); vertical-align: middle; }
  table.sched tr.position-row td { background: rgba(255,213,74,0.05); }
  .wk-cell { font-weight: 700; white-space: nowrap; }
  .matchups { color: var(--ink-dim); font-variant-numeric: tabular-nums; letter-spacing: 0.02em; }
  .lane-col { text-align: center; font-variant-numeric: tabular-nums; color: var(--ink-dim); white-space: nowrap; }
  th.lane-col { text-align: center; }
  .needs-badge {
    display: inline-flex; align-items: center; gap: 6px; font-size: 0.72rem; font-weight: 700;
    color: var(--yellow); background: rgba(255,213,74,0.12); border: 1px solid rgba(255,213,74,0.3);
    padding: 3px 10px; border-radius: 999px;
  }
  .edit-link { color: var(--purple); text-decoration: none; font-size: 0.8rem; font-weight: 600; white-space: nowrap; }

  /* Edit panel */
  .edit-panel-title { font-weight: 700; font-size: 1rem; margin-bottom: 4px; }
  .edit-panel-sub { color: var(--ink-dim); font-size: 0.85rem; margin-bottom: 8px; }
  .auto-note {
    font-size: 0.78rem; color: var(--green); background: rgba(53,214,143,0.08); border: 1px solid rgba(53,214,143,0.25);
    border-radius: 8px; padding: 10px 14px; margin-bottom: 18px;
  }
  .lane-edit-row { display: flex; align-items: center; gap: 10px; margin-bottom: 10px; }
  .lane-edit-row .lane-label { width: 70px; font-size: 0.78rem; color: var(--ink-dim); flex-shrink: 0; }
  .lane-edit-row select {
    flex: 1; font-family: 'Inter', sans-serif; font-size: 0.88rem; padding: 8px 10px;
    border: 1px solid rgba(244,241,251,0.16); border-radius: 6px; background: rgba(11,10,20,0.6); color: var(--ink);
  }
  .lane-edit-row .vs { color: var(--ink-dim); font-size: 0.78rem; }
  .btn-save {
    display: inline-block; font-family: 'Inter', sans-serif; font-weight: 600; font-size: 0.9rem; color: #1a0a0a;
    background: linear-gradient(90deg, var(--orange), var(--red)); padding: 11px 24px; border-radius: 999px; border: none; cursor: pointer; margin-top: 10px;
  }

  footer { background: var(--bg); padding: 28px 24px; text-align: center; color: var(--ink-dim); font-size: 0.85rem; margin-top: 20px; }

  @media (max-width: 800px) {
    .shell { grid-template-columns: 1fr; }
    .sidebar { position: static; }
    table.sched { font-size: 0.76rem; }
  }
</style>
</head>
