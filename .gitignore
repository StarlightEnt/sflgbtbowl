.env*

# Contains every bowler's personal phone/email — not public like the
# standings/schedule fixtures. Revisit only if confirmed this document
# is also already public somewhere.
/test-fixtures/Contact List.pdf

# Even more sensitive than the Contact List — also prints a home
# address on every page. No exceptions.
/test-fixtures/Sanction.pdf

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
